{
  "profile_name": "中文学位论文默认样式（本科、硕士、博士）",
  "_note": "Markdown 层级：# 论文题目（title），## 一级标题/章（headings.level2_*），### 二级标题/节（level3_*），#### 三级标题（level4_*）。headings.level1_* 只给正文里再出现的 # 用，学位论文一般没有。thesis_layout 由 tools/thesis_docx_layout.py 在导出后处理：目录、前置部分页码、章前分页、页眉。学校规范另有要求时由格式解析步骤（_text_profile.json）覆盖。",
  "page": {
    "size": "A4",
    "margin_top_cm": 2.5,
    "margin_bottom_cm": 2.5,
    "margin_left_cm": 3.0,
    "margin_right_cm": 2.5
  },
  "fonts": {
    "chinese_heading": "SimHei",
    "chinese_body": "SimSun",
    "latin": "Times New Roman",
    "monospace": "Consolas"
  },
  "headings": {
    "level1_pt": 16,
    "level2_pt": 16,
    "level3_pt": 14,
    "level4_pt": 12,
    "bold": true,
    "level1_alignment": "center",
    "level2_alignment": "center",
    "level3_alignment": "left",
    "level4_alignment": "left"
  },
  "body": {
    "font_size_pt": 12,
    "line_spacing": 1.5,
    "first_line_indent_chars": 2,
    "space_before_pt": 0,
    "space_after_pt": 0
  },
  "title": {
    "font_size_pt": 18,
    "bold": true,
    "alignment": "center",
    "font_family": "SimHei"
  },
  "abstract": {
    "label_size_pt": 16,
    "body_size_pt": 12,
    "label_bold": true,
    "label_alignment": "center"
  },
  "table": {
    "top_border_pt": 1.5,
    "header_border_pt": 0.75,
    "bottom_border_pt": 1.5,
    "font_size_pt": 10.5,
    "header_bold": true,
    "cell_alignment": "center"
  },
  "references": {
    "hanging_indent_cm": 0.74,
    "font_size_pt": 10.5,
    "numbering_style": "bracket"
  },
  "image": {
    "max_width_cm": 14,
    "alignment": "center"
  },
  "code_block": {
    "font_size_pt": 9,
    "line_spacing": 1.0,
    "background_color": "F5F5F5"
  },
  "thesis_layout": {
    "toc": true,
    "toc_title": "目录",
    "abstract_page_break": true,
    "chapter_page_break": true,
    "front_matter_numbering": "upperRoman",
    "body_numbering": "decimal"
  },
  "header": {
    "text": "",
    "font": "SimSun",
    "font_size_pt": 10.5,
    "alignment": "center",
    "bottom_rule": false
  }
}
