# ============================================================================
# 数维杯（ShuWei Cup）建模工作区 · .gitignore
# ----------------------------------------------------------------------------
# 目标：仓库只保留「可复用资产」——技能、脚本、LaTeX 源、报告、图表、结果 JSON。
# 一切可再生成的中间产物、原始数据副本、二进制模型权重、第三方克隆一律排除。
# 排除清单的判定理由见 docs/REPO_LAYOUT.md 的「为什么排除」一节。
# ============================================================================

# ---------------------------------------------------------------------------
# 0. 亚太杯（APMCM）与国赛练习：不属于本仓库主题
#    实体已迁到 E:\数学建模_apmcm\，这里再兜一层，防止误建同名目录。
# ---------------------------------------------------------------------------
APMCM*/
EXAM_2023C/
PRACTICE_2018A/

# ---------------------------------------------------------------------------
# 1. 环境与解释器（体积巨大且与机器绑定）
# ---------------------------------------------------------------------------
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.pyd
*.so
*.dll
*.exe
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# 2. 第三方克隆（内含自己的 .git 与历史，作为 vendor 只保留文本）
# ---------------------------------------------------------------------------
shuwei/_src/**/.git/
shuwei/_src/**/.git/**
**/.git/

# ---------------------------------------------------------------------------
# 3. LaTeX 中间产物（可重编译，且 diff 噪声极大）
# ---------------------------------------------------------------------------
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.fls
*.fdb_latexmk
*.synctex.gz
*.synctex(busy)
*.blg
*.bbl
*.brf
*.nav
*.snm
*.vrb
*.xdv
*.run.xml
*-blx.bib
verify.pdf
verify.*

# ---------------------------------------------------------------------------
# 4. 大体积二进制与可再生成的数值缓存
#    *.npz 里最大单文件 102 MB（pre_cache.npz）已超 GitHub 单文件 100 MB 硬限；
#    *.pt 是训练权重（可用 code/ 下脚本重训）；*.parquet 是 cdata 的转存副本。
# ---------------------------------------------------------------------------
*.npz
*.npy
*.pt
*.pth
*.ckpt
*.onnx
*.parquet
*.feather
*.arrow
*.h5
*.hdf5
*.pkl
*.joblib
*.sqlite
*.db
*.pack
*.idx
*.bin

# ---------------------------------------------------------------------------
# 5. 原始数据与媒体（赛方附件原样副本；已由 data/ledger.json +
#    data/derived_manifest.json 记录 sha256，可凭清单复原）
# ---------------------------------------------------------------------------
cdata/
*/data/raw/
*/raw/
_downloads/
*.mp4
*.m4s
*.mkv
*.mov
*.avi
*.wav
*.mp3
*.yuv
*.trc
*.mat
*.caj
*.bmp
*.tif
*.tiff
*.psd
*.rar
*.7z
*.tar
*.tar.gz
*.tgz

